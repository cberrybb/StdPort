---
import { type CollectionEntry, getCollection } from 'astro:content';

import ProjectExplorer from '../../components/ProjectExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.data.slug ?? entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const slug = entry.data.slug ?? entry.id;
const heroImage = entry.data.heroImage || entry.data.img || '/assets/stock-1.jpg';
const projectCategory = entry.data.category || entry.data.tags[0] || 'Design';
---

<BaseLayout title={`${entry.data.title} | Leah Moore`} description={entry.data.description}>
	<div class="project-page wrapper">
		<header class="intro-header">
			<a class="back-link" href="/">← Home</a>
			<div class="meta-block">
				<p class="eyebrow">{projectCategory}</p>
				<h1>{entry.data.title}</h1>
				<p class="context">{entry.data.description}</p>
				<div class="meta-row">
					{entry.data.year && <span>{entry.data.year}</span>}
					{entry.data.tags?.length > 0 && <span>{entry.data.tags.join(' / ')}</span>}
				</div>
			</div>
		</header>

		<main class="project-main">
			<img class="hero-image" src={heroImage} alt={entry.data.img_alt || entry.data.title} />
			<ProjectExplorer project={entry} />
		</main>
	</div>
</BaseLayout>

<style>
	.project-page {
		display: grid;
		gap: 2rem;
		padding-block: 1rem 4rem;
	}

	.intro-header {
		display: grid;
		gap: 1rem;
		padding-top: 1rem;
	}

	.back-link {
		color: var(--gray-400);
		text-decoration: none;
	}

	.meta-block {
		display: grid;
		gap: 0.75rem;
		max-width: 58rem;
	}

	.eyebrow {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.meta-block h1 {
		font-size: clamp(2.5rem, 4vw, 5rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
		margin: 0;
	}

	.context {
		margin: 0;
		font-size: var(--text-lg);
		max-width: 42rem;
		color: var(--gray-500);
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--gray-500);
	}

	.project-main {
		display: grid;
		gap: 2rem;
	}

	.hero-image {
		display: block;
		width: 100%;
		height: min(70vh, 44rem);
		object-fit: cover;
		border-radius: 1.5rem;
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-md);
		background: var(--gray-50);
	}

	@media (min-width: 50em) {
		.project-page {
			padding-top: 2rem;
		}
	}
</style>
