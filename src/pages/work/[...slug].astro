---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectExplorer from '../../components/gallery/ProjectExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');

	return work.map((entry) => ({
		params: { slug: entry.data.slug ?? entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;

// PROJECT TEXT FORMATTING
//
// Anchor = where the text column sits.
// Width  = how wide the text column is.
// Text   = alignment inside the column.
//
// Leave a group unset to show its pills.
// Uncomment one choice to lock that group in source and hide its pills.
//
// INLINE MARKDOWN OVERRIDES
// -------------------------
// Use a one-shot [text:...] marker directly in any project .md file.
// It affects only the next paragraph, list, or blockquote, then returns
// automatically to these project-level defaults.
//
// Examples:
// [text:50 /anchor:right /align:left]
// [text:70 /anchor:center /align:justify]
// [text:60]
// 
// Width: 100, 90, 80, 70, 60, 50
// Anchor: left, center, right
// Align: left, center, right, justify
// Any omitted value inherits the project-level setting.

type ProjectTextAnchor = 'left' | 'center' | 'right';
type ProjectTextAlign = 'left' | 'center' | 'right' | 'justify';
type ProjectTextWidth = 100 | 90 | 80 | 70 | 60 | 50;

let projectTextAnchor: ProjectTextAnchor | undefined;
// projectTextAnchor = 'left';
// projectTextAnchor = 'center';
// projectTextAnchor = 'right';

let projectTextWidth: ProjectTextWidth | undefined;
// projectTextWidth = 100;
// projectTextWidth = 90;
// projectTextWidth = 80;
// projectTextWidth = 70;
// projectTextWidth = 60;
// projectTextWidth = 50;

let projectTextAlign: ProjectTextAlign | undefined;
// projectTextAlign = 'left';
// projectTextAlign = 'center';
// projectTextAlign = 'right';
// projectTextAlign = 'justify';

/*
 * Example:
 * src/content/work/P1_advanced/advanced.md
 *
 * projectFolder becomes:
 * P1_advanced
 */
const sourceFile = entry.filePath?.replace(/\\/g, '/') ?? '';
const projectFolder =
	sourceFile.match(/src\/content\/work\/([^/]+)\//)?.[1] ?? '';

const projectImages = import.meta.glob(
	[
		'/src/content/work/**/*.png',
		'/src/content/work/**/*.jpg',
		'/src/content/work/**/*.jpeg',
		'/src/content/work/**/*.webp',
	],
	{
		eager: true,
		query: '?url',
		import: 'default',
	},
) as Record<string, string>;

const folderHero = Object.entries(projectImages).find(([path]) =>
	path.includes(`/src/content/work/${projectFolder}/PHero.`),
)?.[1];

const localHeroImage = entry.data.heroImage
	? Object.entries(projectImages).find(
			([path]) =>
				path ===
				`/src/content/work/${projectFolder}/${entry.data.heroImage}`,
		)?.[1]
	: undefined;

const heroImage = folderHero || localHeroImage;

const projectCategory =
	entry.data.category ||
	entry.data.tags[0] ||
	'Design';

const { Content } = await render(entry);
---

<BaseLayout
	title={`${entry.data.title} | Paige Berry`}
	description={entry.data.description}
>
	<div class="project-page wrapper">
		<header class="intro-header" data-project-intro>
			<div class="header-copy" data-intro-copy>
				<div class="meta-block">
					<p class="eyebrow">{projectCategory}</p>
					<h1>{entry.data.title}</h1>
					<p class="context">{entry.data.description}</p>
					<div class="meta-row">
						{entry.data.year && <span>{entry.data.year}</span>}
						{entry.data.tags?.length > 0 && (
							<span>{entry.data.tags.join(' / ')}</span>
						)}
					</div>
				</div>
			</div>

			{heroImage && (
				<img
					class="hero-image"
					data-hero-image
					src={heroImage}
					alt={entry.data.img_alt || entry.data.title}
				/>
			)}
		</header>

		<main class="project-main">
			<ProjectExplorer project={entry} />

			<div
				class="project-content"
				data-project-content
				data-project-text-anchor={projectTextAnchor ?? 'left'}
				data-project-text-width={projectTextWidth ?? 100}
				data-project-text-align={projectTextAlign ?? 'left'}
			>
				<Content />
			</div>
		</main>
	</div>

	{(
		projectTextAnchor === undefined ||
		projectTextWidth === undefined ||
		projectTextAlign === undefined
	) && (
		<div class="text-setup" aria-label="Project text layout">
			{projectTextAnchor === undefined && (
				<div class="text-setup-group">
					<span>Anchor</span>
					{(['left', 'center', 'right'] as const).map((value) => (
						<button type="button" data-text-anchor={value} aria-pressed={value === 'left' ? 'true' : 'false'}>
							{value === 'left' ? 'L' : value === 'center' ? 'C' : 'R'}
						</button>
					))}
				</div>
			)}

			{projectTextWidth === undefined && (
				<div class="text-setup-group">
					<span>Width</span>
					{([100, 90, 80, 70, 60, 50] as const).map((value) => (
						<button type="button" data-text-width={value} aria-pressed={value === 100 ? 'true' : 'false'}>
							{value}
						</button>
					))}
				</div>
			)}

			{projectTextAlign === undefined && (
				<div class="text-setup-group">
					<span>Text</span>
					{(['left', 'center', 'right', 'justify'] as const).map((value) => (
						<button type="button" data-text-align={value} aria-pressed={value === 'left' ? 'true' : 'false'}>
							{value === 'left' ? 'L' : value === 'center' ? 'C' : value === 'right' ? 'R' : 'J'}
						</button>
					))}
				</div>
			)}
		</div>
	)}

</BaseLayout>

<script>
	const sizePortraitHeroes = () => {
		document.querySelectorAll<HTMLElement>('[data-project-intro]').forEach((header) => {
			const copy = header.querySelector<HTMLElement>('[data-intro-copy]');
			const image = header.querySelector<HTMLImageElement>('[data-hero-image]');
			if (!copy || !image) return;

			const applySize = () => {
				const isPortrait = image.naturalHeight > image.naturalWidth;

				if (!isPortrait) {
					image.classList.remove('is-portrait');
					image.style.removeProperty('--intro-copy-height');
					return;
				}

				image.classList.add('is-portrait');
				image.style.setProperty(
					'--intro-copy-height',
					`${Math.round(copy.getBoundingClientRect().height)}px`,
				);
			};

			if (image.complete) {
				applySize();
			} else {
				image.addEventListener('load', applySize, { once: true });
			}

			window.addEventListener('resize', applySize);
		});
	};

	const textMarkerPattern =
		/^\[text:(100|90|80|70|60|50)(?:\s+\/anchor:(left|center|right))?(?:\s+\/align:(left|center|right|justify))?\s*\]$/i;

	const setupInlineTextMarkers = () => {
		const content = document.querySelector<HTMLElement>('[data-project-content]');
		if (!content) return;

		const markers = Array.from(content.querySelectorAll<HTMLElement>(':scope > p')).filter(
			(paragraph) => textMarkerPattern.test(paragraph.textContent?.trim() ?? ''),
		);

		markers.forEach((marker) => {
			const match = (marker.textContent?.trim() ?? '').match(textMarkerPattern);
			if (!match) return;

			let next = marker.nextElementSibling as HTMLElement | null;
			while (
				next &&
				!['P', 'UL', 'OL', 'BLOCKQUOTE'].includes(next.tagName)
			) {
				next = next.nextElementSibling as HTMLElement | null;
			}

			if (!next) {
				marker.textContent = 'Text marker has no following text block.';
				marker.classList.add('text-marker-error');
				return;
			}

			next.dataset.inlineTextWidth = match[1];
			if (match[2]) next.dataset.inlineTextAnchor = match[2].toLowerCase();
			if (match[3]) next.dataset.inlineTextAlign = match[3].toLowerCase();

			marker.remove();
		});
	};

	const applyProjectTextLayout = () => {
		const content = document.querySelector<HTMLElement>('[data-project-content]');
		if (!content) return;

		const projectAnchor = content.dataset.projectTextAnchor ?? 'left';
		const projectWidth = content.dataset.projectTextWidth ?? '100';
		const projectAlign = content.dataset.projectTextAlign ?? 'left';

		content
			.querySelectorAll<HTMLElement>(':scope > p, :scope > ul, :scope > ol, :scope > blockquote')
			.forEach((element) => {
				if (element.classList.contains('code-window')) return;

				const anchor = element.dataset.inlineTextAnchor ?? projectAnchor;
				const width = element.dataset.inlineTextWidth ?? projectWidth;
				const align = element.dataset.inlineTextAlign ?? projectAlign;

				element.style.setProperty('width', `${width}%`, 'important');
				element.style.setProperty('max-width', 'none', 'important');
				element.style.setProperty('text-align', align, 'important');

				if (anchor === 'center') {
					element.style.setProperty('margin-left', 'auto', 'important');
					element.style.setProperty('margin-right', 'auto', 'important');
				} else if (anchor === 'right') {
					element.style.setProperty('margin-left', 'auto', 'important');
					element.style.setProperty('margin-right', '0', 'important');
				} else {
					element.style.setProperty('margin-left', '0', 'important');
					element.style.setProperty('margin-right', 'auto', 'important');
				}
			});
	};

	const syncProjectTextButtons = () => {
		const content = document.querySelector<HTMLElement>('[data-project-content]');
		if (!content) return;

		document.querySelectorAll<HTMLButtonElement>('[data-text-anchor]').forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.textAnchor === content.dataset.projectTextAnchor));
		});
		document.querySelectorAll<HTMLButtonElement>('[data-text-width]').forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.textWidth === content.dataset.projectTextWidth));
		});
		document.querySelectorAll<HTMLButtonElement>('[data-text-align]').forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.textAlign === content.dataset.projectTextAlign));
		});
	};

	const setupProjectTextControls = () => {
		setupInlineTextMarkers();
		applyProjectTextLayout();
		syncProjectTextButtons();
	};

	if (!document.documentElement.dataset.projectTextControlsBound) {
		document.documentElement.dataset.projectTextControlsBound = 'true';

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const button = target.closest<HTMLButtonElement>('[data-text-anchor], [data-text-width], [data-text-align]');
			if (!button) return;

			const content = document.querySelector<HTMLElement>('[data-project-content]');
			if (!content) return;

			if (button.dataset.textAnchor) content.dataset.projectTextAnchor = button.dataset.textAnchor;
			if (button.dataset.textWidth) content.dataset.projectTextWidth = button.dataset.textWidth;
			if (button.dataset.textAlign) content.dataset.projectTextAlign = button.dataset.textAlign;

			applyProjectTextLayout();
			syncProjectTextButtons();
		});
	}

	sizePortraitHeroes();
	setupProjectTextControls();

	document.addEventListener('astro:page-load', () => {
		sizePortraitHeroes();
		setupProjectTextControls();
	});
</script>

<style>
	.project-page {
		width: 80%;
		margin-inline: auto;
		padding-block: 1rem 4rem;
	}

	.intro-header {
		display: grid;
		gap: 2rem;
		padding-top: 1rem;
		align-items: start;
	}

	.header-copy {
		min-width: 0;
	}

	.meta-block {
		display: grid;
		gap: 0.75rem;
	}

	.eyebrow {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.meta-block h1 {
		font-size: clamp(2.5rem, 4vw, 5rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
		margin: 0;
		color: #26126c;
	}

	.context {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--gray-500);
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--gray-500);
	}

	.hero-image {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 1.5rem;
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-md);
	}

	/*
	 * Portrait heroes are allowed to be larger than the intro copy,
	 * but not to dominate the opening of the project page.
	 *
	 * The cap is 2.5 × the rendered intro-copy height, with a second
	 * 90vh ceiling so there is always breathing room in the viewport.
	 * The image is never cropped.
	 */
	.hero-image.is-portrait {
		width: auto;
		max-width: 100%;
		max-height: min(
			90vh,
			calc(var(--intro-copy-height, 20rem) * 2.5)
		);
		object-fit: contain;
		justify-self: start;
	}

	.project-main {
		display: grid;
		gap: 3rem;
		width: 100%;
		margin-top: 3rem;
	}

	.project-content {
		display: grid;
		gap: 2rem;
		width: 100%;
		max-width: none;
		margin: 0;
		color: #727272;
	}

	/* Everything follows the same left/right page edges. */
	.project-content > :global(*:not(.code-window)) {
		width: 100%;
		max-width: none;
		margin-left: 0;
		margin-right: 0;
	}

	/* Anchor, width and text alignment are applied directly by the
	 * control script so they remain independent and cannot be cancelled
	 * by the general full-width content rule above.
	 */

	.project-content :global(p),
	.project-content :global(li),
	.project-content :global(blockquote) {
		color: #727272;
	}

	.project-content :global(.text-marker-error) {
		width: 100% !important;
		padding: 0.75rem 1rem;
		border: 1px dashed currentColor;
		border-radius: 0.75rem;
		color: var(--gray-400);
	}
    .project-content :global(h1),
	.project-content :global(h2),
	.project-content :global(h3),
	.project-content :global(h4) {
		color: #120841;
	}

	.text-setup {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 100;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.8rem;
		max-width: min(94vw, 48rem);
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--gray-700, #b8b8b8);
		border-radius: 1rem;
		background: var(--gray-999, #ffffff);
		box-shadow: var(--shadow-md);
	}

	.text-setup-group {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.text-setup-group > span {
		margin-right: 0.1rem;
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--gray-500, #727272);
	}

	.text-setup button {
		appearance: none;
		min-width: 2rem;
		border: 1px solid var(--gray-700, #b8b8b8);
		border-radius: 999px;
		background: transparent;
		color: var(--gray-300, #444444);
		font: inherit;
		font-size: var(--text-sm);
		line-height: 1;
		padding: 0.45rem 0.6rem;
		cursor: pointer;
	}

	.text-setup button[aria-pressed='true'] {
		background: var(--accent-regular, #5f4bdb);
		border-color: var(--accent-regular, #5f4bdb);
		color: #ffffff;
	}

	/* Gallery wrappers use the same full width as the hero section. */
	.project-content :global(.standard-gallery),
	.project-content :global(.tile-gallery),
	.project-content :global(.row-gallery) {
		width: 100%;
		max-width: none;
		margin-inline: 0;
	}

	@media (min-width: 50em) {
		.project-page {
			padding-top: 2rem;
		}

		.intro-header {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 3rem;
		}

		.header-copy {
			grid-column: 1;
		}

		.hero-image {
			grid-column: 2;
		}
	}

	@media (max-width: 49.99em) {
		.project-page {
			width: 90%;
		}



		/* On the stacked mobile layout, use the normal full-width hero. */
		.hero-image.is-portrait {
			width: 100%;
			max-height: none;
			justify-self: stretch;
		}
	}
</style>
