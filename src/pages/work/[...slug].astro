---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectExplorer from '../../components/gallery/ProjectExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');

	return work.map((entry) => ({
		params: { slug: entry.data.slug ?? entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;

/*
 * Example:
 * src/content/work/P1_advanced/advanced.md
 *
 * projectFolder becomes:
 * P1_advanced
 */
const sourceFile = entry.filePath?.replace(/\\/g, '/') ?? '';
const projectFolder =
	sourceFile.match(/src\/content\/work\/([^/]+)\//)?.[1] ?? '';

const projectImages = import.meta.glob(
	[
		'/src/content/work/**/*.png',
		'/src/content/work/**/*.jpg',
		'/src/content/work/**/*.jpeg',
		'/src/content/work/**/*.webp',
	],
	{
		eager: true,
		query: '?url',
		import: 'default',
	},
) as Record<string, string>;

const folderHero = Object.entries(projectImages).find(([path]) =>
	path.includes(`/src/content/work/${projectFolder}/PHero.`),
)?.[1];

const localHeroImage = entry.data.heroImage
	? Object.entries(projectImages).find(
			([path]) =>
				path ===
				`/src/content/work/${projectFolder}/${entry.data.heroImage}`,
		)?.[1]
	: undefined;

const heroImage = folderHero || localHeroImage;

const projectCategory =
	entry.data.category ||
	entry.data.tags[0] ||
	'Design';

const { Content } = await render(entry);
---

<BaseLayout
	title={`${entry.data.title} | Paige Berry`}
	description={entry.data.description}
>
	<div class="project-page wrapper">
		<header class="intro-header" data-project-intro>
			<div class="header-copy" data-intro-copy>
				<div class="meta-block">
					<p class="eyebrow">{projectCategory}</p>
					<h1>{entry.data.title}</h1>
					<p class="context">{entry.data.description}</p>
					<div class="meta-row">
						{entry.data.year && <span>{entry.data.year}</span>}
						{entry.data.tags?.length > 0 && (
							<span>{entry.data.tags.join(' / ')}</span>
						)}
					</div>
				</div>
			</div>

			{heroImage && (
				<img
					class="hero-image"
					data-hero-image
					src={heroImage}
					alt={entry.data.img_alt || entry.data.title}
				/>
			)}
		</header>

		<main class="project-main">
			<ProjectExplorer project={entry} />

			<div class="project-content">
				<Content />
			</div>
		</main>
	</div>
</BaseLayout>

<script>
	const sizePortraitHeroes = () => {
		document.querySelectorAll<HTMLElement>('[data-project-intro]').forEach((header) => {
			const copy = header.querySelector<HTMLElement>('[data-intro-copy]');
			const image = header.querySelector<HTMLImageElement>('[data-hero-image]');
			if (!copy || !image) return;

			const applySize = () => {
				const isPortrait = image.naturalHeight > image.naturalWidth;

				if (!isPortrait) {
					image.classList.remove('is-portrait');
					image.style.removeProperty('--intro-copy-height');
					return;
				}

				image.classList.add('is-portrait');
				image.style.setProperty(
					'--intro-copy-height',
					`${Math.round(copy.getBoundingClientRect().height)}px`,
				);
			};

			if (image.complete) {
				applySize();
			} else {
				image.addEventListener('load', applySize, { once: true });
			}

			window.addEventListener('resize', applySize);
		});
	};

	sizePortraitHeroes();
</script>

<style>
	.project-page {
		width: 80%;
		margin-inline: auto;
		padding-block: 1rem 4rem;
	}

	.intro-header {
		display: grid;
		gap: 2rem;
		padding-top: 1rem;
		align-items: start;
	}

	.header-copy {
		min-width: 0;
	}

	.meta-block {
		display: grid;
		gap: 0.75rem;
	}

	.eyebrow {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.meta-block h1 {
		font-size: clamp(2.5rem, 4vw, 5rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
		margin: 0;
		color: #26126c;
	}

	.context {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--gray-500);
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--gray-500);
	}

	.hero-image {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 1.5rem;
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-md);
	}

	/*
	 * Portrait heroes are allowed to be larger than the intro copy,
	 * but not to dominate the opening of the project page.
	 *
	 * The cap is 2.5 × the rendered intro-copy height, with a second
	 * 90vh ceiling so there is always breathing room in the viewport.
	 * The image is never cropped.
	 */
	.hero-image.is-portrait {
		width: auto;
		max-width: 100%;
		max-height: min(
			90vh,
			calc(var(--intro-copy-height, 20rem) * 2.5)
		);
		object-fit: contain;
		justify-self: start;
	}

	.project-main {
		display: grid;
		gap: 3rem;
		width: 100%;
		margin-top: 3rem;
	}

	.project-content {
		display: grid;
		gap: 2rem;
		width: 100%;
		max-width: none;
		margin: 0;
		color: #727272;
	}

	/* Everything follows the same left/right page edges. */
	.project-content > :global(*:not(.code-window)) {
		width: 100%;
		max-width: none;
		margin-left: 0;
		margin-right: 0;
	}

	/* Keep long-form copy readable without changing the page grid. */
	.project-content > :global(p),
	.project-content > :global(ul),
	.project-content > :global(ol),
	.project-content > :global(blockquote) {
		max-width: 58rem;
	}

	.project-content :global(p),
	.project-content :global(li),
	.project-content :global(blockquote) {
		color: #727272;
	}
    .project-content :global(h1),
	.project-content :global(h2),
	.project-content :global(h3),
	.project-content :global(h4) {
		color: #120841;
	}

	/* Gallery wrappers use the same full width as the hero section. */
	.project-content :global(.standard-gallery),
	.project-content :global(.tile-gallery),
	.project-content :global(.row-gallery) {
		width: 100%;
		max-width: none;
		margin-inline: 0;
	}

	@media (min-width: 50em) {
		.project-page {
			padding-top: 2rem;
		}

		.intro-header {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 3rem;
		}

		.header-copy {
			grid-column: 1;
		}

		.hero-image {
			grid-column: 2;
		}
	}

	@media (max-width: 49.99em) {
		.project-page {
			width: 90%;
		}

		/* On the stacked mobile layout, use the normal full-width hero. */
		.hero-image.is-portrait {
			width: 100%;
			max-height: none;
			justify-self: stretch;
		}
	}
</style>
