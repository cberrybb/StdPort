---
import { getCollection } from 'astro:content';

import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort((a, b) => {
	const yearA = Number(a.data.year ?? a.data.publishDate.getFullYear());
	const yearB = Number(b.data.year ?? b.data.publishDate.getFullYear());
	return yearB - yearA;
});
---

<BaseLayout
	title="Paige Berry | Portfolio"
	description="Student designer portfolio featuring recent work across identity, digital design, and art direction."
>
	<div class="page-shell stack gap-20">
		<main class="wrapper stack gap-8">

			<!-- Hero and introduction sit side-by-side on desktop -->
			<div class="hero-row">
				<Hero
					title="Paige Berry"
					tagline="Designer and visual storyteller creating clear, considered work across digital, brand, and editorial systems."
					align="start"
				/>

			</div>

			<section aria-label="Portfolio projects">
				<Grid variant="offset">
					{projects.map((project) => (
						<li>
							<ProjectCard project={project} />
						</li>
					))}
				</Grid>
			</section>

		</main>
	</div>
</BaseLayout>

<style>
	.page-shell {
		padding-block: 1rem 4rem;
	}

	/* Hero and contact introduction layout */
	.hero-row {
		display: grid;
		gap: 2rem;
	}

	.intro-grid {
		display: grid;
		gap: 1rem;
		align-items: center;
		padding: 1.5rem 0;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
	}

	.intro-grid p {
		margin: 0;
		max-width: 34rem;
		font-size: var(--text-lg);
		color: var(--gray-500);
	}

	.intro-grid a {
		justify-self: start;
		padding: 0.75rem 1.25rem;
		border-radius: 999rem;
		background: var(--gray-700);
		color: var(--gray-999);
		text-decoration: none;
	}

	/* Side-by-side hero layout on larger screens */
	@media (min-width: 50em) {
		.hero-row {
			grid-template-columns: minmax(0, 1fr) minmax(28rem, 1fr);
			align-items: end;
			gap: 4rem;
		}

		.intro-grid {
			grid-template-columns: minmax(0, 1fr) auto;
		}
	}
</style>