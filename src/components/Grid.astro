---
interface Props {
	variant?: 'offset' | 'small';
	columns?: 2 | 3;
	authorControlled?: boolean;
}

const { variant, columns = 2, authorControlled = false } = Astro.props;
---

<ul
	class:list={['grid', { offset: variant === 'offset', small: variant === 'small' }]}
	data-card-grid={authorControlled ? '' : undefined}
	data-columns={columns}
>
	<slot />
</ul>

<style>
	.grid {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}

	.grid.small {
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	/* If last row contains only one item, make it span both columns. */
	.grid.small > :global(:last-child:nth-child(odd)) {
		grid-column: 1 / 3;
	}

	@media (min-width: 50em) {
		.grid {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}

		/* Preserve the existing stagger exactly for the normal two-card layout. */
		.grid.offset[data-columns='2'] {
			--row-offset: 7.5rem;
			padding-bottom: var(--row-offset);
		}

		.grid.offset[data-columns='2'] > :global(:nth-child(odd)) {
			transform: translateY(var(--row-offset));
		}

		.grid.offset[data-columns='2'] > :global(:last-child:nth-child(odd)) {
			grid-column: 2 / 3;
			transform: none;
		}

		.grid.small {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
		}

		.grid.small > :global(*) {
			flex-basis: 20rem;
		}
	}

	/* Three-card mode only appears when there is enough room for the card copy. */
	@media (min-width: 70em) {
		.grid[data-columns='3']:not(.small) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}

		/* Three across is intentionally unstaggered. */
		.grid.offset[data-columns='3'] {
			padding-bottom: 0;
		}
	}
</style>
