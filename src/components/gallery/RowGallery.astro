---
/**
 * RowGallery
 *
 *   [gallery:A /row]            -> 3 images per row
 *   [gallery:A /row:3,2,3,2,1] -> explicit row counts
 *
 * Images in a row share a common height. Their widths are weighted from the
 * natural image aspect ratio so portrait and landscape work can sit together.
 *
 * If an explicit pattern runs out before the images do, remaining images
 * continue in rows of 3. If a requested row is larger than the remaining
 * image count, the final row simply uses the remainder.
 */

import type { GalleryGroup } from './gallery';

interface Props {
	groups: GalleryGroup[];
	projectTitle: string;
	source?: boolean;
}

const { groups, projectTitle, source = false } = Astro.props;
const firstGroupKey = groups[0]?.key ?? '';
---

<div
	class="project-explorer row-gallery"
	data-gallery-template={source ? 'row' : undefined}
	hidden={source}
>
	<div class="tabs" role="tablist" aria-label="Project exploration tabs">
		{groups.map(({ key, label }) => {
			const isFirst = key === firstGroupKey;
			return (
				<button
					type="button"
					role="tab"
					aria-selected={isFirst ? 'true' : 'false'}
					data-tab-button={key}
					class:list={['tab-button', { active: isFirst }]}
				>
					{label}
				</button>
			);
		})}
	</div>

	{groups.map(({ key, label, items }) => {
		const isFirst = key === firstGroupKey;
		return (
			<section
				class="gallery-panel"
				role="tabpanel"
				aria-label={`${label} gallery`}
				data-tab-panel={key}
				hidden={!isFirst}
			>
				{items.length > 0 ? (
					<div class="row-items" data-row-items>
						{items.map((image, index) => (
							<figure class="row-item" data-row-item>
								<img
									src={image.url}
									alt={`${projectTitle} ${label} ${index + 1}`}
									loading="lazy"
								/>
							</figure>
						))}
					</div>
				) : (
					<p class="empty">No images available yet.</p>
				)}
			</section>
		);
	})}
</div>

<script>
	const DEFAULT_ROW_COUNT = 3;

	const parsePattern = (value: string | undefined) =>
		(value ?? '')
			.split(',')
			.map((part) => Number.parseInt(part.trim(), 10))
			.filter((count) => Number.isFinite(count) && count > 0);

	const setAspectWeight = (item: HTMLElement) => {
		const image = item.querySelector<HTMLImageElement>('img');
		if (!image) return;

		const apply = () => {
			const ratio =
				image.naturalWidth > 0 && image.naturalHeight > 0
					? image.naturalWidth / image.naturalHeight
					: 1;
			item.style.setProperty('--row-ratio', String(ratio));
		};

		if (image.complete) apply();
		else image.addEventListener('load', apply, { once: true });
	};

	const prepareRowGallery = (gallery: HTMLElement) => {
		const pattern = parsePattern(gallery.dataset.rowPattern);

		gallery.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((panel) => {
			const source = panel.querySelector<HTMLElement>('[data-row-items]');
			if (!source) return;

			const items = Array.from(
				source.querySelectorAll<HTMLElement>(':scope > [data-row-item]'),
			);
			if (items.length === 0) return;

			const rows = document.createElement('div');
			rows.className = 'rows';

			let index = 0;
			let patternIndex = 0;

			while (index < items.length) {
				const requested =
                    pattern.length === 1
                        ? pattern[0]
                        : pattern[patternIndex] ?? DEFAULT_ROW_COUNT;
				const count = Math.min(requested, items.length - index);
				const row = document.createElement('div');
				row.className = 'image-row';
				row.dataset.rowCount = String(count);

				items.slice(index, index + count).forEach((item) => {
					setAspectWeight(item);
					row.appendChild(item);
				});

				rows.appendChild(row);
				index += count;
				patternIndex += 1;
			}

			source.replaceWith(rows);
		});
	};

	document.addEventListener('gallery:inserted', (event) => {
		const gallery = (event as CustomEvent<HTMLElement>).detail;
		if (gallery?.classList.contains('row-gallery')) prepareRowGallery(gallery);
	});

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		const tab = target.closest<HTMLButtonElement>(
			'.row-gallery:not([data-gallery-template]) [data-tab-button]',
		);
		if (!tab) return;

		const gallery = tab.closest<HTMLElement>('.row-gallery');
		const targetKey = tab.dataset.tabButton;
		if (!gallery || !targetKey) return;

		gallery.querySelectorAll<HTMLButtonElement>('[data-tab-button]').forEach((item) => {
			const active = item.dataset.tabButton === targetKey;
			item.setAttribute('aria-selected', String(active));
			item.classList.toggle('active', active);
		});

		gallery.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((panel) => {
			panel.hidden = panel.dataset.tabPanel !== targetKey;
		});
	});
</script>

<style>
	.project-explorer {
		display: grid;
		gap: 1.5rem;
		width: 80%;
		margin-inline: auto;
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tab-button {
		appearance: none;
		border: 1px solid var(--gray-800);
		background: transparent;
		border-radius: 999rem;
		padding: 0.7rem 1.1rem;
		font: inherit;
		font-weight: 600;
		color: var(--gray-400);
		cursor: pointer;
		transition:
			background-color var(--theme-transition),
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.tab-button.active,
	.tab-button[aria-selected='true'] {
		background: var(--gray-700);
		border-color: var(--gray-700);
		color: var(--gray-999);
	}

	:global(.row-gallery:not([data-gallery-template]) .rows) {
		display: grid;
		gap: 1rem;
	}

	:global(.row-gallery:not([data-gallery-template]) .image-row) {
		display: flex;
		gap: 1rem;
		width: 100%;
		height: clamp(12rem, 26vw, 28rem);
	}

	.row-item {
		flex: var(--row-ratio, 1) 1 0;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border-radius: 1rem;
		background: var(--gray-50);
	}

	.row-item img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.empty {
		padding: 1.5rem;
		border: 1px dashed var(--gray-800);
		border-radius: 1rem;
		color: var(--gray-400);
	}

	@media (max-width: 42em) {
		:global(.row-gallery:not([data-gallery-template]) .image-row) {
			height: clamp(9rem, 42vw, 16rem);
			gap: 0.6rem;
		}

		:global(.row-gallery:not([data-gallery-template]) .rows) {
			gap: 0.6rem;
		}
	}
</style>
