---
/**
 * ProjectExplorer
 *
 * The coordinator for project galleries.
 *
 * Its job is deliberately narrow:
 * 1. Ask gallery.ts to resolve this project's gallery data.
 * 2. Render hidden StandardGallery and TileGallery source templates.
 * 3. Find gallery markers in the rendered Markdown.
 * 4. Clone the correct renderer into each marker position.
 *
 * It does NOT know how standard or tile galleries are visually rendered.
 * It does NOT know how filenames map to images.
 *
 * CURRENT MARKDOWN LANGUAGE
 * -------------------------
 * [gallery:A]          standard gallery
 * [gallery:A,B]        combined standard gallery
 * [gallery:A /tile]           tile gallery with authoring QA
 * [gallery:A,B /tile]         combined tile gallery
 * [gallery:A /tile /p]        tile gallery with QA warnings suppressed
 * [gallery:A /row]            row gallery, 3 images per row by default
 * [gallery:A /row:3,2,3,2,1] row gallery with explicit row counts
 * [image: A3.png /w:80]     specific image at 80% of text-frame width, left aligned
 * [image: A3.png /w:80 /L]  explicit left alignment
 * [image: A3.png /w:80 /C]  centred on the project frame
 * [video: demo.mp4 /w:80]      video at 80% of text-frame width, left aligned
 * [video: demo.mp4 /w:80 /L]   explicit left alignment
 * [video: demo.mp4 /w:80 /C]   centred
 * [video: demo.mp4 /w:80 /R]   right aligned
 *
 * /p affects QA only. It never hides the gallery.
 *
 * IMPORTANT ARCHITECTURAL NOTE
 * ----------------------------
 * Markdown is rendered by the project page after this component, so Astro
 * cannot directly replace gallery markers at build time here. The hidden
 * source-template + clone step is therefore retained intentionally for this
 * behaviour-preserving refactor. A future architecture can remove it, but
 * that should be a separate change.
 */

import type { CollectionEntry } from 'astro:content';
import { buildGalleryGroups, buildProjectImages, buildProjectVideos } from './gallery';
import StandardGallery from './StandardGallery.astro';
import TileGallery from './TileGallery.astro';
import RowGallery from './RowGallery.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const galleryGroups = buildGalleryGroups(project);
const projectImages = buildProjectImages(project);
const projectVideos = buildProjectVideos(project);
---

{
	galleryGroups.length > 0 && (
		<div data-project-gallery-sources>
			<StandardGallery
				groups={galleryGroups}
				projectTitle={project.data.title}
				source
			/>
			<TileGallery
				groups={galleryGroups}
				projectTitle={project.data.title}
				source
			/>
			<RowGallery
				groups={galleryGroups}
				projectTitle={project.data.title}
				source
			/>
		</div>
	)
}

{
	projectImages.length > 0 && (
		<div data-project-image-sources hidden>
			{
				projectImages.map((image) => (
					<span
						data-project-image-name={image.name}
						data-project-image-url={image.url}
					/>
				))
			}
		</div>
	)
}

{
	projectVideos.length > 0 && (
		<div data-project-video-sources hidden>
			{
				projectVideos.map((video) => (
					<span
						data-project-video-name={video.name}
						data-project-video-url={video.url}
					/>
				))
			}
		</div>
	)
}

<script>
	/**
	 * Keep marker parsing small and explicit. New presentation modes should
	 * become renderers, not branches full of rendering code in this file.
	 */
	const markerPattern =
		/^\[gallery:\s*([a-z0-9_-]+(?:\s*,\s*[a-z0-9_-]+)*)(?:\s+\/(tile|row(?::\d+(?:,\d+)*)?))?(?:\s+\/(p))?\s*\]$/i;

	const imageMarkerPattern =
		/^\[image:\s*(.+?)(?:\s+\/w:(\d{1,3}))?(?:\s+\/(L|C|R))?\s*\]$/i;

	const videoMarkerPattern =
		/^\[video:\s*(.+?)(?:\s+\/w:(\d{1,3}))?(?:\s+\/(L|C|R))?\s*\]$/i;

	const sources = document.querySelector<HTMLElement>('[data-project-gallery-sources]');
	const imageSources = document.querySelector<HTMLElement>('[data-project-image-sources]');
	const videoSources = document.querySelector<HTMLElement>('[data-project-video-sources]');
	const standardSource = sources?.querySelector<HTMLElement>('[data-gallery-template="standard"]');
	const tileSource = sources?.querySelector<HTMLElement>('[data-gallery-template="tile"]');
	const rowSource = sources?.querySelector<HTMLElement>('[data-gallery-template="row"]');
	const content = document.querySelector('.project-content');

	const makeGalleryInstance = (
		keys: string[],
		layout: 'standard' | 'tile' | 'row',
		publishMode: boolean,
		rowPattern = '',
	) => {
		const source =
			layout === 'tile'
				? tileSource
				: layout === 'row'
					? rowSource
					: standardSource;
		if (!source) return null;

		const gallery = source.cloneNode(true) as HTMLElement;
		gallery.removeAttribute('data-gallery-template');
		gallery.removeAttribute('hidden');

		if (publishMode && layout === 'tile') {
			gallery.setAttribute('data-publish-mode', '');
		}

		if (layout === 'row') {
			gallery.dataset.rowPattern = rowPattern;
		}

		const wanted = new Set(keys.map((key) => key.toLowerCase()));

		gallery.querySelectorAll<HTMLElement>('[data-tab-button]').forEach((tab) => {
			const key = tab.dataset.tabButton?.toLowerCase() ?? '';
			if (!wanted.has(key)) tab.remove();
		});

		gallery.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((panel) => {
			const key = panel.dataset.tabPanel?.toLowerCase() ?? '';
			if (!wanted.has(key)) panel.remove();
		});

		const tabs = gallery.querySelectorAll<HTMLButtonElement>('[data-tab-button]');
		const panels = gallery.querySelectorAll<HTMLElement>('[data-tab-panel]');
		if (panels.length === 0) return null;

		// Reset active state after filtering. This fixes combined/single markers
		// that do not include the project's first declared gallery.
		// An empty gallery label deliberately produces no tab button.
		// The gallery panel must still remain active and visible.
		const firstKey =
			tabs[0]?.dataset.tabButton ??
			panels[0]?.dataset.tabPanel ??
			'';
		tabs.forEach((tab, index) => {
			const active = index === 0;
			tab.setAttribute('aria-selected', String(active));
			tab.classList.toggle('active', active);
		});
		panels.forEach((panel) => {
			panel.hidden = panel.dataset.tabPanel !== firstKey;
		});

		return gallery;
	};

	if (sources && content) {
		const markers = Array.from(content.querySelectorAll('p')).filter((paragraph) =>
			markerPattern.test(paragraph.textContent?.trim() ?? ''),
		);

		markers.forEach((paragraph) => {
			const match = (paragraph.textContent?.trim() ?? '').match(markerPattern);
			if (!match) return;

			const keys = match[1]
				.split(',')
				.map((key) => key.trim())
				.filter(Boolean);

			const mode = match[2]?.toLowerCase() ?? '';
			const layout =
				mode.startsWith('row')
					? 'row'
					: mode === 'tile'
						? 'tile'
						: 'standard';
			const rowPattern = mode.startsWith('row:') ? mode.slice(4) : '';
			const publishMode = match[3]?.toLowerCase() === 'p';
			const gallery = makeGalleryInstance(keys, layout, publishMode, rowPattern);

			if (gallery) {
				paragraph.replaceWith(gallery);
				document.dispatchEvent(
					new CustomEvent('gallery:inserted', { detail: gallery }),
				);
			} else {
				paragraph.textContent = `Gallery not found: ${keys.join(', ')}`;
				paragraph.classList.add('gallery-marker-error');
			}
		});
	}

	const makeMediaWidthResponsive = (
		figure: HTMLElement,
		requestedPercent: number,
		excludedParagraph: HTMLElement,
	) => {
		const findReferenceParagraph = () =>
			Array.from(content!.querySelectorAll<HTMLElement>('p')).find((candidate) => {
				if (candidate === excludedParagraph) return false;
				const candidateText = candidate.textContent?.trim() ?? '';
				return (
					candidateText.length > 0 &&
					!markerPattern.test(candidateText) &&
					!imageMarkerPattern.test(candidateText) &&
					!videoMarkerPattern.test(candidateText)
				);
			});

		const updateWidth = () => {
			const referenceParagraph = findReferenceParagraph();
			const textFrameWidth =
				referenceParagraph?.getBoundingClientRect().width ??
				content!.getBoundingClientRect().width;

			// Recalculate from the CURRENT text width every time the layout changes.
			// This prevents an image/video's old pixel width from holding the page open.
			figure.style.width = `${textFrameWidth * (requestedPercent / 100)}px`;
			figure.style.maxWidth = '100%';
		};

		updateWidth();

		const observer = new ResizeObserver(updateWidth);
		observer.observe(content!);

		const referenceParagraph = findReferenceParagraph();
		if (referenceParagraph) observer.observe(referenceParagraph);

		window.addEventListener('resize', updateWidth);
	};

	if (imageSources && content) {
		const imageMarkers = Array.from(content.querySelectorAll('p')).filter((paragraph) =>
			imageMarkerPattern.test(paragraph.textContent?.trim() ?? ''),
		);

		imageMarkers.forEach((paragraph) => {
			const match = (paragraph.textContent?.trim() ?? '').match(imageMarkerPattern);
			if (!match) return;

			const requestedName = match[1].trim();
			const requestedWidth = Number(match[2] ?? '100');
			const width = Math.max(1, requestedWidth);
			const alignment = (match[3] ?? 'L').toUpperCase();
			const sourceImage = Array.from(
				imageSources.querySelectorAll<HTMLElement>('[data-project-image-name]'),
			).find(
				(image) =>
					(image.dataset.projectImageName ?? '').toLowerCase() ===
					requestedName.toLowerCase(),
			);

			if (!sourceImage) {
				paragraph.textContent = `Image not found: ${requestedName}`;
				paragraph.classList.add('gallery-marker-error');
				return;
			}

			const figure = document.createElement('figure');
			figure.className = 'project-inline-image';

			// /w is always relative to the CURRENT rendered text width.
			makeMediaWidthResponsive(figure, width, paragraph);

			if (alignment === 'C') {
				figure.style.marginInline = 'auto';
			} else if (alignment === 'R') {
				figure.style.marginLeft = 'auto';
				figure.style.marginRight = '0';
			} else {
				figure.style.marginLeft = '0';
				figure.style.marginRight = 'auto';
			}

			const image = document.createElement('img');
			image.src = sourceImage.dataset.projectImageUrl ?? '';
			image.alt = requestedName.replace(/\.[^.]+$/, '');
			figure.appendChild(image);

			paragraph.replaceWith(figure);
		});
	}

	if (videoSources && content) {
		const videoMarkers = Array.from(content.querySelectorAll('p')).filter((paragraph) =>
			videoMarkerPattern.test(paragraph.textContent?.trim() ?? ''),
		);

		videoMarkers.forEach((paragraph) => {
			const match = (paragraph.textContent?.trim() ?? '').match(videoMarkerPattern);
			if (!match) return;

			const requestedName = match[1].trim();
			const requestedWidth = Number(match[2] ?? '100');
			const width = Math.max(1, requestedWidth);
			const alignment = (match[3] ?? 'L').toUpperCase();

			const sourceVideo = Array.from(
				videoSources.querySelectorAll<HTMLElement>('[data-project-video-name]'),
			).find(
				(video) =>
					(video.dataset.projectVideoName ?? '').toLowerCase() ===
					requestedName.toLowerCase(),
			);

			if (!sourceVideo) {
				paragraph.textContent = `Video not found: ${requestedName}`;
				paragraph.classList.add('gallery-marker-error');
				return;
			}

			const figure = document.createElement('figure');
			figure.className = 'project-inline-video';

			// /w is always relative to the CURRENT rendered text width.
			makeMediaWidthResponsive(figure, width, paragraph);

			if (alignment === 'C') {
				figure.style.marginInline = 'auto';
			} else if (alignment === 'R') {
				figure.style.marginLeft = 'auto';
				figure.style.marginRight = '0';
			} else {
				figure.style.marginLeft = '0';
				figure.style.marginRight = 'auto';
			}

			const video = document.createElement('video');
			video.src = sourceVideo.dataset.projectVideoUrl ?? '';
			video.controls = true;
			video.playsInline = true;
			video.preload = 'metadata';
			figure.appendChild(video);

			paragraph.replaceWith(figure);
		});
	}

	sources?.remove();
	imageSources?.remove();
	videoSources?.remove();
</script>

<style>
	:global(.gallery-marker-error) {
		padding: 0.75rem 1rem;
		border: 1px dashed currentColor;
		border-radius: 0.75rem;
		color: var(--gray-400);
	}

	:global(.project-inline-image) {
		margin: 0;
		min-width: 0;
		max-width: 100%;
	}

	:global(.project-inline-image img) {
		display: block;
		width: 100%;
		height: auto;
	}

	:global(.project-inline-video) {
		margin: 0;
		min-width: 0;
		max-width: 100%;
	}

	:global(.project-inline-video video) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
