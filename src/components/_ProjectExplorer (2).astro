---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;

const sourceFile = project.filePath?.replace(/\\/g, '/');
const projectDir = sourceFile?.slice(0, sourceFile.lastIndexOf('/')) ?? '';

const allProjectImages = import.meta.glob(
	[
		'/src/content/work/**/*.png',
		'/src/content/work/**/*.jpg',
		'/src/content/work/**/*.jpeg',
		'/src/content/work/**/*.webp',
		'/src/content/work/**/*.gif',
		'/src/content/work/**/*.avif',
	],
	{
		eager: true,
		query: '?url',
		import: 'default',
	},
) as Record<string, string>;

const galleryDefinition = project.data.gallery ?? {};

const escapeRegExp = (value: string) =>
	value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const galleryGroups = Object.entries(galleryDefinition).map(([key, label]) => {
	const filePattern = new RegExp(
		`^${escapeRegExp(key)}(\\d+)(T?)\\.(png|jpe?g|webp|gif|avif)$`,
		'i',
	);

	const folderPrefix = projectDir ? `/${projectDir}/` : '';

	const discovered = Object.entries(allProjectImages)
		.map(([path, url]) => {
			if (!folderPrefix || !path.startsWith(folderPrefix)) return null;

			const fileName = path.slice(folderPrefix.length);

			if (fileName.includes('/')) return null;

			const match = fileName.match(filePattern);
			if (!match) return null;

			return {
				url,
				order: Number(match[1]),
				isTile: match[2].toLowerCase() === 't',
				fileName,
			};
		})
		.filter(
			(item): item is {
				url: string;
				order: number;
				isTile: boolean;
				fileName: string;
			} => item !== null,
		);

	const byOrder = new Map<
		number,
		{ url?: string; tileUrl?: string; fileName?: string }
	>();

	discovered.forEach((item) => {
		const current = byOrder.get(item.order) ?? {};

		if (item.isTile) {
			current.tileUrl = item.url;
		} else {
			current.url = item.url;
			current.fileName = item.fileName;
		}

		byOrder.set(item.order, current);
	});

	const items = Array.from(byOrder.entries())
		.filter(([, item]) => Boolean(item.url))
		.sort(([a], [b]) => a - b)
		.map(([order, item]) => ({
			url: item.url as string,
			tileUrl: item.tileUrl,
			order,
		}));

	return {
		key,
		label,
		items,
	};
});

const firstGroupKey = galleryGroups[0]?.key ?? '';
---

{
	galleryGroups.length > 0 && (
		<div class="project-explorer" data-gallery-source>
			<div class="tabs" role="tablist" aria-label="Project exploration tabs">
				{galleryGroups.map(({ key, label }) => {
					const isFirst = key === firstGroupKey;

					return (
						<button
							type="button"
							role="tab"
							aria-selected={isFirst ? 'true' : 'false'}
							data-tab-button={key}
							class:list={['tab-button', { active: isFirst }]}
						>
							{label}
						</button>
					);
				})}
			</div>

			{galleryGroups.map(({ key, label, items }) => {
				const isFirst = key === firstGroupKey;

				return (
					<section
						class="gallery-panel"
						role="tabpanel"
						aria-label={`${label} gallery`}
						data-tab-panel={key}
						hidden={!isFirst}
					>
						{items.length > 0 ? (
							<div class="gallery-layout">
								<div class="thumbs" aria-label={`${label} thumbnails`}>
									{items.map((image, index) => (
										<button
											type="button"
											class:list={[
												'thumb',
												{ selected: index === 0 && isFirst },
											]}
											data-panel={key}
											data-full={image.url}
											data-tile={image.tileUrl}
											data-tile-label={`${key}${image.order}T missing`}
											data-alt={`${project.data.title} ${label} ${index + 1}`}
											aria-label={`View ${label} image ${index + 1}`}
											aria-pressed={
												index === 0 && isFirst ? 'true' : 'false'
											}
										>
											<img
												src={image.url}
												alt=""
												width="180"
												height="120"
												loading="lazy"
											/>
										</button>
									))}
								</div>

								<figure class="viewer">
									<img
										data-viewer={key}
										src={items[0].url}
										alt={`${project.data.title} ${label}`}
										loading="lazy"
									/>
								</figure>
							</div>
						) : (
							<p class="empty">No images available yet.</p>
						)}
					</section>
				);
			})}
		</div>
	)
}

<script>
	const gallerySource = document.querySelector<HTMLElement>(
		'.project-explorer[data-gallery-source]',
	);

	const initialiseGallery = (gallery: HTMLElement) => {
		const tabs = gallery.querySelectorAll<HTMLButtonElement>('[data-tab-button]');
		const panels = gallery.querySelectorAll<HTMLElement>('[data-tab-panel]');
		const firstTab = tabs[0];
		const firstKey = firstTab?.dataset.tabButton ?? '';

		const setActiveTab = (targetKey: string) => {
			tabs.forEach((tab) => {
				const isActive = tab.dataset.tabButton === targetKey;
				tab.setAttribute('aria-selected', String(isActive));
				tab.classList.toggle('active', isActive);
			});

			panels.forEach((panel) => {
				panel.hidden = panel.dataset.tabPanel !== targetKey;
			});
		};

		if (firstKey) setActiveTab(firstKey);

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const targetKey = tab.dataset.tabButton;
				if (targetKey) setActiveTab(targetKey);
			});
		});

		panels.forEach((panel) => {
			const thumbs = panel.querySelectorAll<HTMLButtonElement>('[data-full]');
			const viewer = panel.querySelector<HTMLImageElement>('[data-viewer]');

			thumbs.forEach((thumb, index) => {
				const isFirst = index === 0;
				thumb.setAttribute('aria-pressed', String(isFirst));
				thumb.classList.toggle('selected', isFirst);

				thumb.addEventListener('click', () => {
					const nextSrc = thumb.dataset.full;
					const nextAlt =
						thumb.dataset.alt || viewer?.getAttribute('alt') || '';

					if (viewer && nextSrc) {
						viewer.setAttribute('src', nextSrc);
						viewer.setAttribute('alt', nextAlt);
					}

					thumbs.forEach((item) => {
						const selected = item === thumb;
						item.setAttribute('aria-pressed', String(selected));
						item.classList.toggle('selected', selected);
					});
				});
			});
		});
	};

	const makeGalleryInstance = (keys: string[], layout: 'standard' | 'tile' = 'standard') => {
		if (!gallerySource) return null;

		const gallery = gallerySource.cloneNode(true) as HTMLElement;
		gallery.removeAttribute('data-gallery-source');

		const wanted = new Set(keys.map((key) => key.toLowerCase()));

		gallery.querySelectorAll<HTMLElement>('[data-tab-button]').forEach((tab) => {
			const key = tab.dataset.tabButton?.toLowerCase() ?? '';
			if (!wanted.has(key)) tab.remove();
		});

		gallery.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((panel) => {
			const key = panel.dataset.tabPanel?.toLowerCase() ?? '';
			if (!wanted.has(key)) panel.remove();
		});

		if (!gallery.querySelector('[data-tab-panel]')) return null;

		if (layout === 'tile') {
			gallery.classList.add('tile-gallery');

			gallery.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((panel) => {
				const layoutElement = panel.querySelector<HTMLElement>('.gallery-layout');
				const thumbs = panel.querySelector<HTMLElement>('.thumbs');
				const viewer = panel.querySelector<HTMLElement>('.viewer');

				if (!layoutElement || !thumbs) return;

				layoutElement.classList.add('tile-grid');

				thumbs.querySelectorAll<HTMLButtonElement>('.thumb').forEach((thumb) => {
					const image = thumb.querySelector<HTMLImageElement>('img');
					const full = thumb.dataset.full;
					const tile = thumb.dataset.tile;
					const alt = thumb.dataset.alt ?? '';
					const missingLabel = thumb.dataset.tileLabel ?? 'Tile image missing';

					if (image && full) {
						image.src = tile || full;
						image.alt = alt;
						image.removeAttribute('width');
						image.removeAttribute('height');
					}

					if (!tile) {
						const warning = document.createElement('span');
						warning.className = 'tile-missing';
						warning.textContent = missingLabel;
						thumb.appendChild(warning);
					}
				});

				viewer?.remove();
			});

			initialiseGallery(gallery);
			return gallery;
		}

		initialiseGallery(gallery);
		return gallery;
	};

	if (gallerySource) {
		const markerPattern = /^\[gallery:\s*([a-z0-9_-]+(?:\s*,\s*[a-z0-9_-]+)*)(?:\s+\/(tile))?\s*\]$/i;
		const content = document.querySelector('.project-content');
		const markers = content
			? Array.from(content.querySelectorAll('p')).filter((paragraph) =>
				markerPattern.test(paragraph.textContent?.trim() ?? ''),
			)
			: [];

		if (markers.length === 0) {
			gallerySource.remove();
		} else {
			markers.forEach((paragraph) => {
				const match = (paragraph.textContent?.trim() ?? '').match(markerPattern);
				if (!match) return;

				const keys = match[1]
					.split(',')
					.map((key) => key.trim())
					.filter(Boolean);

				const layout = match[2]?.toLowerCase() === 'tile' ? 'tile' : 'standard';
				const gallery = makeGalleryInstance(keys, layout);

				if (gallery) {
					paragraph.replaceWith(gallery);
				} else {
					paragraph.textContent = `Gallery not found: ${keys.join(', ')}`;
					paragraph.classList.add('gallery-marker-error');
				}
			});

			gallerySource.remove();
		}
	}
</script>

<style>
	.project-explorer {
		display: grid;
		gap: 1.5rem;
			width: 80%;
	        margin-inline: auto;
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tab-button {
		appearance: none;
		border: 1px solid var(--gray-800);
		background: transparent;
		border-radius: 999rem;
		padding: 0.7rem 1.1rem;
		font: inherit;
		font-weight: 600;
		color: var(--gray-400);
		cursor: pointer;
		transition:
			background-color var(--theme-transition),
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.tab-button.active,
	.tab-button[aria-selected='true'] {
		background: var(--gray-700);
		border-color: var(--gray-700);
		color: var(--gray-999);
	}

	.gallery-panel {
		transition: opacity 220ms ease;
	}

	.gallery-layout {
		display: grid;
		gap: 1rem;
	}

	.thumbs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
		gap: 0.75rem;
	}

	.thumb {
		padding: 0;
		border: 1px solid var(--gray-800);
		border-radius: 0.9rem;
		overflow: hidden;
		background: var(--gray-999);
		cursor: pointer;
		transition:
			border-color var(--theme-transition),
			transform var(--theme-transition);
	}

	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb.selected,
	.thumb[aria-pressed='true'] {
		border-color: var(--gray-0);
	}

	.viewer {
		margin: 0;
		border-radius: 1.25rem;
		overflow: hidden;
		background: var(--gray-50);
		border: 1px solid var(--gray-800);
	}

	.viewer img {
		display: block;
		width: 100%;
		height: min(70vh, 48rem);
		object-fit: contain;
		background: var(--gray-50);
	}

	.tile-gallery .tabs {
		margin-bottom: 0;
	}

	.tile-gallery .tile-grid {
		display: block;
	}

	.tile-gallery .thumbs {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.tile-gallery .thumb {
		aspect-ratio: 1 / 1;
		border-radius: 1rem;
		cursor: default;
	}

	.tile-gallery .thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tile-gallery .thumb {
		position: relative;
		overflow: hidden;
	}

	.tile-gallery :global(.tile-missing) {
		position: absolute;
		inset: auto 0 0 0;
		padding: 0.55rem 0.7rem;
		background: rgba(255, 255, 255, 0.88);
		color: #111;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		pointer-events: none;
	}

	.empty {
		padding: 1.5rem;
		border: 1px dashed var(--gray-800);
		border-radius: 1rem;
		color: var(--gray-400);
	}

	:global(.gallery-marker-error) {
		padding: 0.75rem 1rem;
		border: 1px dashed currentColor;
		border-radius: 0.75rem;
		color: var(--gray-400);
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-panel,
		.tab-button,
		.thumb {
			transition: none;
		}
	}

	@media (min-width: 34em) {
		.tile-gallery .thumbs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64em) {
		.tile-gallery .thumbs {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 50em) {
		.gallery-layout {
			grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
			align-items: start;
		}

		.thumbs {
			grid-template-columns: 1fr;
		}

		.tile-gallery .thumbs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64em) {
		.tile-gallery .thumbs {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
