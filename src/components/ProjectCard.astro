---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const image = project.data.cardImage || project.data.img || '/assets/stock-1.jpg';
const year = project.data.year ?? project.data.publishDate.getFullYear();
const category = project.data.category || project.data.tags[0] || 'Design';
const href = `/work/${project.data.slug ?? project.id}`;
---

<a class="project-card" href={href}>
	<img src={image} alt={project.data.img_alt || project.data.title} loading="lazy" decoding="async" />
	<div class="project-info">
		<div class="project-topline">
			<span>{category}</span>
			{year && <span>{year}</span>}
		</div>
		<h2>{project.data.title}</h2>
	</div>
</a>

<style>
	.project-card {
		display: grid;
		grid-template-rows: 1fr auto;
		text-decoration: none;
		color: inherit;
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
	}

	.project-card:hover,
	.project-card:focus-visible {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.project-card img {
		display: block;
		width: 100%;
		height: 20rem;
		object-fit: cover;
		background: var(--gray-50);
	}

	.project-info {
		display: grid;
		gap: 0.4rem;
		padding: 1rem 1rem 1.25rem;
	}

	.project-topline {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.project-info h2 {
		margin: 0;
		font-size: clamp(1.5rem, 2vw, 2.2rem);
		line-height: 1.05;
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.project-card img {
			height: 26rem;
		}
	}
</style>
