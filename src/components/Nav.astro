---
import Icon from './Icon.astro';

const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Contact Me', href: '/contact/' },
];

const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav>
	<div class="menu-header">
		<a href="/" class="site-logo" aria-label="Paige Berry home">
			<span class="print-stage" aria-hidden="true">

				<!-- Positive impression -->
				<span class="impression">
					<img src="/assets/PBLogo.jpg" alt="" />
				</span>

				<!-- Moving printing block -->
				<span class="type-block">
					<img src="/assets/PBLogo.jpg" alt="" />
				</span>

			</span>
		</a>

		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>

	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={isCurrentPage(href) ? 'page' : null}
							class="link"
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>

	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={isCurrentPage(href) ? 'page' : null}
							class="link"
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			this.appendChild(
				this.querySelector('template')!.content.cloneNode(true)
			);

			const btn = this.querySelector('button')!;
			const menu = document.getElementById('menu-content')!;

			menu.hidden = true;
			menu.classList.add('menu-content');

			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			btn.addEventListener('click', () => {
				setExpanded(menu.hidden === true);
			});

			const handleViewports = (
				e: MediaQueryList | MediaQueryListEvent
			) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};

			const mediaQueries = window.matchMedia('(min-width: 50em)');

			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}

	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3.5rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	/* =========================================
	   PB BLOCK PRINT
	   ========================================= */

	.site-logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.print-stage {
		position: relative;
		display: block;
		width: 5.7rem;
		height: 2.5rem;
	}

	.type-block,
	.impression {
		position: absolute;
		top: 0;
		width: 2.5rem;
		height: 2.5rem;
	}

	.type-block {
		left: 0;
		z-index: 2;
		transform-origin: center;
	}

	/* Original positive print appears here */
	.impression {
		left: 3.1rem;
		z-index: 1;
		opacity: 0;
	}

	.type-block img,
	.impression img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/*
		SEQUENCE

		1. Original block slides right
		2. Block reaches print position
		3. Positive impression appears
		4. Block withdraws left
		5. While withdrawing it flips through its edge
		6. Reverse face becomes mirrored + inverted
		7. Reverse block arrives back on left
	*/

	.site-logo:hover .type-block,
	.site-logo:focus-visible .type-block {
		animation: block-print 2.1s ease-in-out forwards;
	}

	.site-logo:hover .impression,
	.site-logo:focus-visible .impression {
		animation: impression-print 2.1s ease-out forwards;
	}

	/* ---------- BLOCK ---------- */

	@keyframes block-print {

		/* Original block */
		0% {
			transform:
				translateX(0)
				scaleX(1);

			filter: none;
		}

		/* Slide right */
		35% {
			transform:
				translateX(1.6rem)
				scaleX(1);

			filter: none;
		}

		/* Reach print position */
		55% {
			transform:
				translateX(3.1rem)
				scaleX(1);

			filter: none;
		}

		/* Brief contact */
		62% {
			transform:
				translateX(3.1rem)
				scaleX(1);

			filter: none;
		}

		/*
			Withdraw and begin flipping.
			The print is now being revealed.
		*/
		72% {
			transform:
				translateX(2.2rem)
				scaleX(0.45);

			filter: none;
		}

		/* Almost edge-on */
		78% {
			transform:
				translateX(1.6rem)
				scaleX(0.04);

			filter: none;
		}

		/*
			Cross the edge.
			Reverse face becomes inverted here.
		*/
		79% {
			transform:
				translateX(1.5rem)
				scaleX(-0.04);

			filter: invert(1);
		}

		/* Mirrored reverse face opens */
		88% {
			transform:
				translateX(0.7rem)
				scaleX(-0.65);

			filter: invert(1);
		}

		/*
			Final state:
			mirrored + inverted block on left.
		*/
		100% {
			transform:
				translateX(0)
				scaleX(-1);

			filter: invert(1);
		}
	}

	/* ---------- PRINT ---------- */

	@keyframes impression-print {

		0%,
		57% {
			opacity: 0;
		}

		/* Block begins lifting away */
		63% {
			opacity: 0.25;
		}

		/* Print is revealed */
		70% {
			opacity: 1;
		}

		/* Positive print remains */
		100% {
			opacity: 1;
		}
	}

	/* =========================================
	   MENU
	   ========================================= */

	.menu-button {
		position: relative;
		display: flex;
		border: 0;
		border-radius: 999rem;
		padding: 0.5rem;
		font-size: 1.5rem;
		color: var(--gray-300);
		background: var(--gray-999);
		box-shadow: var(--shadow-md);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		background: var(--gray-900);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--gray-800);
		border-radius: 999rem;
		z-index: -1;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
	}

	.link[aria-current] {
		color: var(--gray-0);
	}

	/* =========================================
	   DESKTOP
	   ========================================= */

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 2.5rem 5rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.menu-content {
			display: contents;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			font-size: var(--text-sm);
			border-radius: 999rem;
			border: 1px solid var(--gray-800);
			padding: 0.5rem 0.5625rem;
			background: var(--gray-999);
			box-shadow: var(--shadow-md);
		}

		.nav-items::before {
			position: absolute;
			inset: -1px;
			content: '';
			background: var(--gray-800);
			border-radius: 999rem;
			z-index: -1;
		}

		.link {
			padding: 0.5rem 1rem;
			border-radius: 999rem;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link:hover,
		.link:focus {
			color: var(--gray-0);
			background-color: var(--gray-50);
		}

		.link[aria-current='page'] {
			color: var(--gray-999);
			background-color: var(--gray-700);
		}
	}

	/* ---------- ACCESSIBILITY ---------- */

	@media (prefers-reduced-motion: reduce) {
		.site-logo:hover .type-block,
		.site-logo:hover .impression,
		.site-logo:focus-visible .type-block,
		.site-logo:focus-visible .impression {
			animation: none;
		}
	}

	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>