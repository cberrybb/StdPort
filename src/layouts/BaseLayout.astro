---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script is:inline>
			(() => {
				const enhanceCodeBlocks = () => {
					document.querySelectorAll('pre').forEach((pre) => {
						if (pre.closest('.code-window')) return;

						const code = pre.querySelector(':scope > code');
						if (!code) return;

						const text = code.textContent ?? '';
						const lines = text.replace(/\n$/, '').split('\n');
						const lineCount = Math.max(1, lines.length);

						const languageClass = [...code.classList].find((name) =>
							name.startsWith('language-')
						);
						const language = languageClass
							? languageClass.replace('language-', '').replace(/[-_]/g, ' ')
							: 'code';
						const label = language.charAt(0).toUpperCase() + language.slice(1);

						const windowEl = document.createElement('div');
						windowEl.className = 'code-window';

						const header = document.createElement('div');
						header.className = 'code-window__header';

						const meta = document.createElement('span');
						meta.className = 'code-window__pill code-window__meta';
						meta.textContent = `${label} · ${lineCount} ${lineCount === 1 ? 'line' : 'lines'}`;

						const copy = document.createElement('button');
						copy.className = 'code-window__pill code-window__copy';
						copy.type = 'button';
						copy.textContent = 'Copy';
						copy.setAttribute('aria-label', `Copy ${label} code`);

						const collapse = document.createElement('button');
						collapse.className = 'code-window__pill code-window__collapse';
						collapse.type = 'button';
						collapse.textContent = 'Collapse';
						collapse.hidden = true;

						copy.addEventListener('click', async () => {
							try {
								await navigator.clipboard.writeText(text);
								copy.textContent = 'Copied';
								window.setTimeout(() => {
									copy.textContent = 'Copy';
								}, 1200);
							} catch {
								const selection = window.getSelection();
								const range = document.createRange();
								range.selectNodeContents(code);
								selection?.removeAllRanges();
								selection?.addRange(range);
							}
						});

						header.append(meta, copy, collapse);

						const preview = document.createElement('div');
						preview.className = 'code-window__preview';

						const previewPre = document.createElement('pre');
						const previewCode = document.createElement('code');
						previewCode.textContent = lines.slice(0, 5).join('\n');
						previewPre.append(previewCode);
						preview.append(previewPre);

						const full = document.createElement('div');
						full.className = 'code-window__full';
						full.hidden = true;

						// Insert the wrapper before moving the original <pre>.
						pre.before(windowEl);
						windowEl.append(header, preview, full);

						if (lineCount > 5) {
							const continued = document.createElement('button');
							continued.className = 'code-window__continued';
							continued.type = 'button';
							continued.textContent = '…continued';
							continued.setAttribute('aria-expanded', 'false');

							const openFull = () => {
								preview.hidden = true;
								full.hidden = false;
								collapse.hidden = false;
								continued.setAttribute('aria-expanded', 'true');
							};

							const closeFull = () => {
								full.hidden = true;
								preview.hidden = false;
								collapse.hidden = true;
								continued.setAttribute('aria-expanded', 'false');
							};

							continued.addEventListener('click', openFull);
							collapse.addEventListener('click', closeFull);

							preview.append(continued);
							full.append(pre);
						} else {
							preview.hidden = true;
							full.hidden = false;
							full.append(pre);
						}
					});
				};

				enhanceCodeBlocks();
				document.addEventListener('astro:page-load', enhanceCodeBlocks);
			})();
		</script>

		<style>
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background: var(--gray-999);
			}
		</style>
	</body>
</html>
